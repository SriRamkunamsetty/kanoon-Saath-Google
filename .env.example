# Google AI Studio API key for Gemini. Server-side only — never expose
# this to the client. Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Upstash Redis REST credentials, used only for request rate limiting.
# Create a free database at https://console.upstash.com
# The app degrades to a permissive in-memory limiter if these are
# unset, so it still runs locally without an Upstash account —
# see lib/ratelimit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
